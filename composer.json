{
    "name": "risetechapps/risetools",
    "description": "Coleção de macros e helpers Laravel criados pela RiseTechApps.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rise Tech",
            "email": "apps@risetech.com.br",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "RiseTechApps\\RiseTools\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RiseTechApps\\RiseTools\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "illuminate/cache": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/mail": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/redis": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "laravel/serializable-closure": "^2.0",
        "jeremykendall/php-domain-parser": "^6.0",
        "spatie/dns": "^2.8.1",
        "io-developer/php-whois": "4.1.10",
        "symfony/process": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "hisorange/browser-detect": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "ext-gd": "*",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "ext-gd": "Required by AvatarGenerator.",
        "ext-sqlite3": "Required by DatabaseSnapshot on SQLite connections.",
        "ext-intl": "Recommended by jeremykendall/php-domain-parser for IDN domains (Domain)."
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "RiseTechApps\\RiseTools\\RiseToolsServiceProvider"
            ],
            "aliases": {
                "RiseTools": "RiseTechApps\\RiseTools\\RiseToolsFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.1.0"
}
